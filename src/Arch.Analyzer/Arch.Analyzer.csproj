<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <EnforceExtendedAnalyzerRules>false</EnforceExtendedAnalyzerRules>

    <!-- Empacotamento de analyzer (ADR-001 §5, "Empacotamento") -->
    <PackageId>Arch.Analyzer</PackageId>
    <Version>0.1.0</Version>
    <Description>Motor de regras arquiteturais configurável via YAML — Roslyn Analyzer (ADR-001).</Description>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <DevelopmentDependency>true</DevelopmentDependency>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <NoPackageAnalysis>true</NoPackageAnalysis>
    <!-- NU5128: "não há dependência de lib para netstandard2.0" — esperado para analyzer-only
         package (IncludeBuildOutput=false). Não é um defeito a corrigir. -->
    <NoWarn>$(NoWarn);NU5128</NoWarn>

    <!-- Um netstandard2.0 "class library" comum NÃO copia DLLs de PackageReference para o
         bin de saída por padrão (CopyLocalLockFileAssemblies=false é o default do SDK para
         esse TFM) — só gera o .deps.json. build/ilrepack.targets continua necessitando do
         YamlDotNet.dll fisicamente em $(OutDir) para fundir com ILRepack, então isso segue
         forçado aqui. (Ainda necessário depois de o merge ter migrado de AfterTargets="Build"
         para BeforeTargets="_GetPackageFiles": o Pack roda o Build antes e continua LENDO de
         $(OutDir) — só não escreve mais lá.) -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>

    <!-- Aponta o ILRepack.Lib.MSBuild.Task para o alvo custom do repositório em vez do seu
         Target default (ver comentário em build/ilrepack.targets). -->
    <ILRepackTargetsFile>$(MSBuildThisFileDirectory)../../build/ilrepack.targets</ILRepackTargetsFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Fixada na menor versão suportada, PrivateAssets=all (ADR-001 §5) — fornecida pelo
         host do compilador em runtime, não deve virar dependência nem ser fundida. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" PrivateAssets="all" />

    <!-- Parser YAML (ADR-001 D1) — fundido e internalizado por build/ilrepack.targets, nunca
         distribuído como DLL própria. PrivateAssets=all + SuppressDependenciesWhenPacking
         garantem que ele não vaza como dependência no .nuspec do pacote. -->
    <PackageReference Include="YamlDotNet" Version="13.1.0" PrivateAssets="all" />

    <!-- Executa o merge/internalize durante o Pack, não no build (ver ILRepackTargetsFile acima
         e o bloco "POR QUE ESTE TARGET RODA SÓ NO PACK" em build/ilrepack.targets). -->
    <PackageReference Include="ILRepack.Lib.MSBuild.Task" Version="2.0.46" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- Modelo de configuração (LayerDefinition/RuleDefinition/ArchConfig/LayerMatchCriterion),
         dono é Arch.Config (PLANO-implementacao.md, "Estrutura do repositório"). -->
    <ProjectReference Include="..\Arch.Config\Arch.Config.csproj" />

    <!-- Contratos IRuleEvaluator/ILayerResolver, extraídos para projeto próprio (sem depender
         de Arch.Analyzer) para quebrar o ciclo Arch.Analyzer <-> Arch.Rules. Implementados em
         LayerResolver.cs e consumidos em ArchRulesAnalyzer.cs/RuleEvaluatorRegistry.cs. -->
    <ProjectReference Include="..\Arch.Analyzer.Contracts\Arch.Analyzer.Contracts.csproj" />

    <!-- Avaliadores concretos de regra (Fase 2), instanciados em RuleEvaluatorRegistry.Default. -->
    <ProjectReference Include="..\Arch.Rules\Arch.Rules.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- build/<PackageId>.targets (ADR-001 §5, "Empacotamento"): o SDK do NuGet importa este
         arquivo automaticamente em todo projeto que instale o pacote, e é ele que adiciona o
         `arch-rules.yaml` do consumidor aos @(AdditionalFiles). Sem isso, instalar o pacote e
         criar o YAML não produz diagnóstico NENHUM — o analyzer sai pela saída rápida de
         OnCompilationStart por não achar o AdditionalFile, silenciosamente.

         Item ESTÁTICO (diferente do <None> da DLL fundida, que é injetado em tempo de Pack por
         build/ilrepack.targets): este arquivo existe fisicamente no repositório e não depende de
         nenhum passo de build. O PackagePath precisa ser exatamente build/Arch.Analyzer.targets —
         o NuGet só importa build/<PackageId>.(props|targets). -->
    <None Include="$(MSBuildThisFileDirectory)../../build/Arch.Analyzer.targets"
          Pack="true" PackagePath="build/Arch.Analyzer.targets" Visible="false" />
  </ItemGroup>

  <!-- NÃO declarar aqui um <None Include="$(OutputPath)$(AssemblyName).dll" Pack="true" .../>.
       Esse item estático existia e empacotava o assembly NÃO fundido de $(OutDir) — correto só
       enquanto o merge sobrescrevia $(OutDir) no post-build, o que quebrava os projetos de teste
       com CS0433. O único item que entrega a DLL em analyzers/dotnet/cs agora é o <None> dinâmico
       injetado pelo Target ArchAnalyzerMergeForPack em build/ilrepack.targets, apontando para o
       resultado fundido no intermediate output. -->

</Project>
