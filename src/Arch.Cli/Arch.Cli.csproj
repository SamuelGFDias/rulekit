<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <OutputType>Exe</OutputType>
    <RootNamespace>Arch.Cli</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Fase 3 / PLANO-implementacao.md: "net10.0 — gerador de .globalconfig e lock file",
         distribuído como dotnet tool (ADR-001 §9 Action Item #5: "gerador CLI é dotnet tool
         global ou local ao repositório" — decidido aqui como dotnet tool, instalável tanto
         global quanto local ao repo via manifesto, sem exigir que o consumidor clone a lib). -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>arch-rules</ToolCommandName>
    <PackageId>RuleKit.Cli</PackageId>
    <IsPackable>true</IsPackable>
    <Description>RuleKit.Cli (arch-rules): ferramenta de linha de comando que valida o arch-rules.yaml e gera o .globalconfig e o lock file (id → slot → severidade) do RuleKit. Command-line tool that validates arch-rules.yaml and generates the .globalconfig and lock file for RuleKit.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- Roda também em runtimes mais novos que o net10.0 de compilação. -->
    <RollForward>Major</RollForward>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="\" Visible="false" />
    <None Include="../../THIRD-PARTY-NOTICES.txt" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- Arch.Config: parser (ArchConfigParser.Parse da cadeia), ExtendsChainResolver (resolução
         de `extends`, compartilhada com o analyzer — issue #18; aqui só o loader de disco, ver
         ExtendsResolver.cs), SlotPool e SeverityVocabulary. O CLI não referencia YamlDotNet
         diretamente: a única leitura de YAML é a do Arch.Config, que o traz por transitividade. -->
    <ProjectReference Include="../Arch.Config/Arch.Config.csproj" />
  </ItemGroup>

  <!--
    Parsing de argumentos: implementado à mão (ver Program.cs) em vez de referenciar
    System.CommandLine. Motivo (decisão desta trilha, documentada por exigência do prompt): a
    superfície de comandos é mínima e estável, dois subcomandos ('gen'/'validate'), cada um com um
    argumento posicional e no máximo uma opção (a flag 'out'), sem subcomandos aninhados, nem
    negociação de tipos complexos, nem necessidade de geração de texto de ajuda sofisticado.
    Adicionar uma dependência externa (ainda em pré lançamento estável no ecossistema .NET, com
    breaking changes entre betas) para esse escopo trocaria poucas dezenas de linhas de código
    óbvio e testável por uma superfície de API externa a rastrear, sem ganho real de robustez para
    o caso de uso. Caso o CLI cresça (mais subcomandos, autocompletar de shell, ajuda rica),
    revisitar.
  -->

</Project>
