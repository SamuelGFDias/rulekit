<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <!-- Fundido em Arch.Analyzer.dll no pack (roda dentro do compilador): mesmas regras de
         analyzer (RS1035 — sem I/O) que Arch.Analyzer, issue #7. -->
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Arch.Analyzer.Contracts/Arch.Analyzer.Contracts.csproj" />
    <ProjectReference Include="../Arch.Config/Arch.Config.csproj" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
  </ItemGroup>

</Project>
