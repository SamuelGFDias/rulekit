<?xml version="1.0" encoding="utf-8"?>
<!--
  NuGet.Config do consumidor de spike (Fase 0). Aponta para o feed local gerado pelo
  `dotnet pack` dos dois analyzers de spike (tests/_local-nuget-feed) além do nuget.org
  normal, para que o restore resolva Arch.Analyzer.Spike e Arch.Spike.ControlAnalyzer sem
  publicar nada externamente.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="local-spike-feed" value="../_local-nuget-feed" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
