<?xml version="1.0" encoding="utf-8"?>
<!--
  Feed local do dogfooding (Fase 4, trilha 4A). Aponta para tests/_local-nuget-feed, onde o
  `dotnet pack src/Arch.Analyzer -c Release -o tests/_local-nuget-feed` grava o Arch.Analyzer.nupkg.
  Mesmo padrão já usado por tests/Arch.Spike.Consumer/NuGet.Config.

  ATENÇÃO ao trocar de versão do pacote: o NuGet cacheia o .nupkg extraído em
  ~/.nuget/packages/arch.analyzer/<versao>/. Reempacotar a MESMA versão não invalida esse cache —
  limpe-o (`rm -rf ~/.nuget/packages/arch.analyzer`) antes de reconstruir, senão o build continua
  usando o analyzer antigo.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="local-dogfood-feed" value="../../_local-nuget-feed" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
